<Window x:Class="EasyOpenCore.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EasyOpenCore.App.ViewModels"
        xmlns:l="clr-namespace:EasyOpenCore.App.Localization"
        Title="EasyOpenCore" Width="1320" Height="840" MinWidth="1000" MinHeight="640"
        Background="{StaticResource BgBrush}" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen" Loaded="OnLoaded">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Kext / SSDT / boot-arg row: monospace name + reason -->
        <DataTemplate x:Key="PlanItemTemplate">
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="{Binding Name}" FontFamily="Cascadia Mono, Consolas" FontSize="12.5"/>
                <TextBlock Text="{Binding Reason}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="MutedLineTemplate">
            <TextBlock Text="{Binding}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>
        </DataTemplate>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <!-- Collapses a section whose Tag (bound to a collection count) is 0 -->
        <Style x:Key="HideWhenEmpty" TargetType="StackPanel">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Status lines that should take no space while empty -->
        <Style x:Key="CollapseWhenEmpty" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Secondary button that sits on a card background -->
        <Style x:Key="CardButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Background" Value="{StaticResource CardHoverBrush}"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
        <Style x:Key="NavIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="Margin" Value="0,2,12,0"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
        </Style>
        <Style x:Key="NavLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl TabStripPlacement="Left" Background="Transparent" BorderThickness="0" Padding="0">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="22,22,22,18">
                                    <TextBlock Text="EasyOpenCore" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock Text="{l:Tr app.subtitle}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                                <!-- Space for the language picker, which is overlaid outside the template so it stays in the automation tree -->
                                <Border DockPanel.Dock="Bottom" Height="120"/>
                                <StackPanel IsItemsHost="True"/>
                            </DockPanel>
                        </Border>
                        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1" ContentSource="SelectedContent"/>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>

            <!-- ============ OVERVIEW ============ -->
            <TabItem Style="{StaticResource NavTab}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE80F;" Style="{StaticResource NavIcon}"/>
                        <TextBlock Text="{l:Tr nav.overview}" Style="{StaticResource NavLabel}"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,18">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource GhostButton}" Content="{l:Tr overview.export}" Margin="0,0,8,0"
                                        Click="OnExportJson" IsEnabled="{Binding HasReport}"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="{l:Tr overview.rescan}" Click="OnRescan"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{l:Tr overview.title}" FontSize="24" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding MachineTitle}" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,16"
                                Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding Compat.Recommendation}" FontWeight="SemiBold"/>
                                    <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0">
                                        <Run Text="{Binding BlockerCount, Mode=OneWay}" Foreground="{StaticResource BlockerBrush}" FontWeight="SemiBold"/>
                                        <Run Text="{l:Tr overview.blockers}"/>
                                        <Run Text="{Binding WarningCount, Mode=OneWay}" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold"/>
                                        <Run Text="{l:Tr overview.warnings}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Cards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,12,12">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="16"
                                                           Foreground="{StaticResource AccentBrush}" Margin="0,1,10,0"/>
                                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Headline}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                            <ItemsControl ItemsSource="{Binding Details}" ItemTemplate="{StaticResource MutedLineTemplate}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ COMPATIBILITY ============ -->
            <TabItem Style="{StaticResource NavTab}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7B8;" Style="{StaticResource NavIcon}"/>
                        <TextBlock Text="{l:Tr nav.compat}" Style="{StaticResource NavLabel}"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24" DataContext="{Binding Compat}">
                    <StackPanel>
                        <TextBlock Text="{l:Tr compat.title}" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="{l:Tr compat.subtitle}" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,16" TextWrapping="Wrap"/>

                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="3,0,0,0"
                                CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                            <TextBlock Text="{Binding Recommendation}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Matrix -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="300"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{l:Tr compat.component}" Style="{StaticResource SectionTitle}" VerticalAlignment="Bottom"/>
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Versions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap"
                                                           Foreground="{StaticResource MutedBrush}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="300"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                                    </StackPanel>
                                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}" VerticalAlignment="Center">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <UniformGrid Rows="1"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Width="30" Height="30" CornerRadius="6" Background="{StaticResource CardHoverBrush}"
                                                                        HorizontalAlignment="Center" ToolTip="{Binding Tooltip}" ToolTipService.InitialShowDelay="150">
                                                                    <TextBlock Text="{Binding Level, Converter={StaticResource LevelGlyph}}"
                                                                               FontFamily="{StaticResource IconFont}" FontSize="13"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                               Foreground="{Binding Level, Converter={StaticResource LevelBrush}}"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- Legend -->
                                <WrapPanel Margin="0,10,0,0">
                                    <WrapPanel.Resources>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="FontSize" Value="11.5"/>
                                            <Setter Property="Margin" Value="0,0,16,0"/>
                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                        </Style>
                                    </WrapPanel.Resources>
                                    <TextBlock><Run Text="&#xE73E;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource SupportedBrush}"/> <Run Text="{l:Tr level.Supported}"/></TextBlock>
                                    <TextBlock><Run Text="&#xE90F;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource PatchedBrush}"/> <Run Text="{l:Tr level.Patched}"/></TextBlock>
                                    <TextBlock><Run Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource WarningBrush}"/> <Run Text="{l:Tr level.Limited}"/></TextBlock>
                                    <TextBlock><Run Text="&#xE9CE;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource UnknownBrush}"/> <Run Text="{l:Tr level.Unknown}"/></TextBlock>
                                    <TextBlock><Run Text="&#xE711;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource BlockerBrush}"/> <Run Text="{l:Tr level.Unsupported}"/></TextBlock>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Plan for the selected version -->
                        <TextBlock Text="{l:Tr compat.plan_title}" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,4"/>
                        <TextBlock Text="{l:Tr compat.plan_subtitle}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                        <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding Versions}"
                                 SelectedItem="{Binding SelectedChip}" Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{l:Tr compat.smbios}" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="{Binding Smbios}" FontFamily="Cascadia Mono, Consolas" FontSize="16"/>
                                        <TextBlock Text="{Binding SmbiosReason}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{l:Tr compat.ssdts}" Style="{StaticResource SectionTitle}"/>
                                        <ItemsControl ItemsSource="{Binding Ssdts}" ItemTemplate="{StaticResource PlanItemTemplate}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{l:Tr compat.bootargs}" Style="{StaticResource SectionTitle}"/>
                                        <ItemsControl ItemsSource="{Binding BootArgs}" ItemTemplate="{StaticResource PlanItemTemplate}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{l:Tr compat.devprops}" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="{l:Tr compat.devprops_none}" Foreground="{StaticResource MutedBrush}" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DeviceProperties.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ItemsControl ItemsSource="{Binding DeviceProperties}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,8">
                                                        <TextBlock Text="{Binding PciPath}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Foreground="{StaticResource MutedBrush}"/>
                                                        <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="12.5">
                                                            <Run Text="{Binding Key, Mode=OneWay}"/> = <Run Text="{Binding Value, Mode=OneWay}" Foreground="{StaticResource AccentBrush}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{l:Tr compat.kexts}" Style="{StaticResource SectionTitle}"/>
                                        <ItemsControl ItemsSource="{Binding Kexts}" ItemTemplate="{StaticResource PlanItemTemplate}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <StackPanel Style="{StaticResource HideWhenEmpty}" Tag="{Binding NotWorking.Count}">
                                            <TextBlock Text="{l:Tr compat.not_working}" Style="{StaticResource SectionTitle}" Foreground="{StaticResource BlockerBrush}"/>
                                            <ItemsControl ItemsSource="{Binding NotWorking}" ItemTemplate="{StaticResource MutedLineTemplate}"/>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource HideWhenEmpty}" Tag="{Binding Warnings.Count}">
                                            <TextBlock Text="{l:Tr compat.warnings}" Style="{StaticResource SectionTitle}" Foreground="{StaticResource WarningBrush}" Margin="0,4,0,8"/>
                                            <ItemsControl ItemsSource="{Binding Warnings}" ItemTemplate="{StaticResource MutedLineTemplate}"/>
                                        </StackPanel>
                                        <TextBlock Text="{l:Tr compat.all_working}" Foreground="{StaticResource SupportedBrush}" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding NotWorking.Count}" Value="0"/>
                                                                <Condition Binding="{Binding Warnings.Count}" Value="0"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{l:Tr compat.acpi_facts}" Style="{StaticResource SectionTitle}"/>
                                        <ItemsControl ItemsSource="{Binding AcpiFacts}" ItemTemplate="{StaticResource MutedLineTemplate}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{l:Tr compat.disclaimer}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ BUILD EFI ============ -->
            <TabItem Style="{StaticResource NavTab}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE835;" Style="{StaticResource NavIcon}"/>
                        <TextBlock Text="{l:Tr nav.build}" Style="{StaticResource NavLabel}"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24" DataContext="{Binding Build}">
                    <StackPanel>
                        <TextBlock Text="{l:Tr build.title}" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="{l:Tr build.subtitle}" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,16" TextWrapping="Wrap"/>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{l:Tr build.target_label}" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{Binding TargetText}" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="{l:Tr build.target_hint}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" Margin="0,2,0,14"/>

                                <TextBlock Text="{l:Tr build.folder_label}" Style="{StaticResource SectionTitle}"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{l:Tr build.browse}" Margin="8,0,0,0" Click="OnBrowseOutput"/>
                                    <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                                </DockPanel>
                                <CheckBox IsChecked="{Binding DebugBuild}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{l:Tr build.debug}"/>
                                        <TextBlock Text="{l:Tr build.debug_hint}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </CheckBox>

                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button Style="{StaticResource PrimaryButton}" Content="{l:Tr build.button}" Click="OnBuild" IsEnabled="{Binding CanBuild}"/>
                                    <Button Style="{StaticResource GhostButton}" Content="{l:Tr build.open}" Margin="8,0,0,0" Click="OnOpenEfi"
                                            Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}"/>
                                    <ProgressBar Width="160" Height="4" IsIndeterminate="True" Margin="16,0,0,0" VerticalAlignment="Center"
                                                 Visibility="{Binding IsBuilding, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Error}" Foreground="{StaticResource BlockerBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="OCVALIDATE" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{Binding ValidationText}" FontSize="15" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Foreground" Value="{StaticResource BlockerBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ValidationPassed}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource SupportedBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding ValidationOutput}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- USB installer -->
                        <Border Style="{StaticResource Card}" DataContext="{Binding DataContext.Installer, RelativeSource={RelativeSource AncestorType=Window}}">
                            <StackPanel>
                                <TextBlock Text="{l:Tr installer.title}" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{l:Tr installer.subtitle}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{l:Tr installer.refresh}" Margin="8,0,0,0" Click="OnRefreshDisks"/>
                                    <ComboBox ItemsSource="{Binding Disks}" SelectedItem="{Binding SelectedDisk}" VerticalContentAlignment="Center"
                                              AutomationProperties.Name="{l:Tr installer.title}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Display}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </DockPanel>
                                <CheckBox IsChecked="{Binding IncludeRecovery}" Margin="0,10,0,0">
                                    <TextBlock Text="{l:Tr installer.recovery}"/>
                                </CheckBox>
                                <CheckBox IsChecked="{Binding Format}" Margin="0,6,0,0">
                                    <TextBlock Text="{l:Tr installer.format}" Foreground="{StaticResource WarningBrush}"/>
                                </CheckBox>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Style="{StaticResource PrimaryButton}" Content="{l:Tr installer.create}" Click="OnCreateUsb" IsEnabled="{Binding CanCreate}"/>
                                    <ProgressBar Width="220" Height="6" Margin="16,0,0,0" VerticalAlignment="Center" Maximum="100" Value="{Binding Progress, Mode=OneWay}"
                                                 Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" VerticalAlignment="Top" Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="{l:Tr build.kexts}" Style="{StaticResource SectionTitle}"/>
                                    <ItemsControl ItemsSource="{Binding Kexts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding Title}" FontFamily="Cascadia Mono, Consolas" FontSize="12.5"/>
                                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="SSDTS" Style="{StaticResource SectionTitle}" Margin="0,8,0,8"/>
                                    <ItemsControl ItemsSource="{Binding Ssdts}" ItemTemplate="{StaticResource MutedLineTemplate}"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource Card}" Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{l:Tr build.manual}" Style="{StaticResource SectionTitle}" Foreground="{StaticResource WarningBrush}"/>
                                        <ItemsControl ItemsSource="{Binding ManualSteps}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,8">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{l:Tr build.log}" Style="{StaticResource SectionTitle}"/>
                                        <ItemsControl ItemsSource="{Binding Log}" ItemTemplate="{StaticResource MutedLineTemplate}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ USB MAPPING ============ -->
            <TabItem Style="{StaticResource NavTab}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE88E;" Style="{StaticResource NavIcon}"/>
                        <TextBlock Text="{l:Tr nav.usb}" Style="{StaticResource NavLabel}"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24" DataContext="{Binding Usb}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,16">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Style="{StaticResource GhostButton}" Content="{l:Tr usb.reset}" Margin="0,0,8,0" Click="OnResetUsbMap"/>
                                <Button Style="{StaticResource GhostButton}" Content="{l:Tr usb.install}" Margin="0,0,8,0" Click="OnInstallUsbMap"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="{Binding DiscoverText}" Click="OnToggleDiscovery"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{l:Tr usb.title}" FontSize="24" FontWeight="SemiBold"/>
                                <TextBlock Text="{l:Tr usb.subtitle}" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="{l:Tr usb.hint}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="{Binding Message}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <ItemsControl ItemsSource="{Binding Controllers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,10">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" VerticalAlignment="Center" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Setter Property="Foreground" Value="{StaticResource SupportedBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding OverLimit}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource BlockerBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}" FontSize="11.5"/>
                                                </StackPanel>
                                            </DockPanel>
                                            <ItemsControl ItemsSource="{Binding Ports}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="6" Padding="10,6" Margin="0,0,0,4">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{StaticResource CardHoverBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Connected}" Value="True">
                                                                            <Setter Property="Background" Value="#1F3FB950"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <DockPanel>
                                                                <ComboBox DockPanel.Dock="Right" Width="250" VerticalAlignment="Center"
                                                                          ItemsSource="{Binding DataContext.Usb.Connectors, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          SelectedValuePath="Value" SelectedValue="{Binding Connector}"
                                                                          AutomationProperties.Name="{l:Tr usb.connector}">
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding Label}"/>
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>
                                                                <CheckBox IsChecked="{Binding Selected}" VerticalAlignment="Center" Margin="0,0,10,0"
                                                                          AutomationProperties.Name="{Binding Title}"/>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ POST-INSTALL ============ -->
            <TabItem Style="{StaticResource NavTab}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" Style="{StaticResource NavIcon}"/>
                        <TextBlock Text="{l:Tr nav.postinstall}" Style="{StaticResource NavLabel}"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24" DataContext="{Binding PostInstall}">
                    <StackPanel>
                        <TextBlock Text="{l:Tr postinstall.title}" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="{l:Tr postinstall.subtitle}" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,16" TextWrapping="Wrap"/>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{l:Tr postinstall.folder}" Style="{StaticResource SectionTitle}"/>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Style="{StaticResource GhostButton}" Content="{l:Tr postinstall.browse}" Margin="8,0,0,0" Click="OnPostInstallBrowse" IsEnabled="{Binding IsIdle}"/>
                                        <Button Style="{StaticResource GhostButton}" Content="{l:Tr postinstall.open}" Margin="8,0,0,0" Click="OnPostInstallOpen" IsEnabled="{Binding IsIdle}"/>
                                        <Button Style="{StaticResource GhostButton}" Content="{l:Tr postinstall.use_last}" Margin="8,0,0,0" Click="OnPostInstallUseLast" IsEnabled="{Binding IsIdle}"/>
                                    </StackPanel>
                                    <TextBox Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                                             AutomationProperties.Name="{l:Tr postinstall.folder}"/>
                                </DockPanel>
                                <TextBlock Text="{Binding LoadedText}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Style="{StaticResource GhostButton}" Content="{l:Tr postinstall.discard}" Margin="0,0,8,0" Click="OnPostInstallDiscard" IsEnabled="{Binding CanApply}"/>
                                        <Button Style="{StaticResource PrimaryButton}" Content="{l:Tr postinstall.apply}" Click="OnPostInstallApply" IsEnabled="{Binding CanApply}"/>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PendingText}" FontWeight="SemiBold"/>
                                        <ProgressBar Height="4" Margin="0,6,24,0" IsIndeterminate="True" Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Style="{StaticResource CollapseWhenEmpty}"/>
                                <TextBlock Text="{Binding ValidationText}" FontWeight="SemiBold" Margin="0,6,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CollapseWhenEmpty}">
                                            <Setter Property="Foreground" Value="{StaticResource BlockerBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ValidationPassed}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource SupportedBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding ValidationOutput}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Style="{StaticResource CollapseWhenEmpty}"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,6,0,0">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}"/>
                                        <Border Style="{StaticResource Card}" Padding="6">
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="6" Padding="12,10">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Changed}" Value="True">
                                                                            <Setter Property="Background" Value="#1F4F8CFF"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <DockPanel>
                                                                <Button DockPanel.Dock="Right" Style="{StaticResource CardButton}" Content="{l:Tr postinstall.guide}"
                                                                        VerticalAlignment="Top" Click="OnOpenUrl" Tag="{Binding Url}"/>
                                                                <CheckBox IsChecked="{Binding Wanted}" VerticalAlignment="Top" Margin="0,2,12,0"
                                                                          AutomationProperties.Name="{Binding Title}">
                                                                    <CheckBox.IsEnabled>
                                                                        <MultiBinding Converter="{StaticResource AllTrue}">
                                                                            <Binding Path="IsAvailable"/>
                                                                            <Binding Path="DataContext.PostInstall.IsIdle" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                        </MultiBinding>
                                                                    </CheckBox.IsEnabled>
                                                                </CheckBox>
                                                                <StackPanel Margin="0,0,12,0">
                                                                    <WrapPanel>
                                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                                                        <TextBlock Text="{l:Tr postinstall.recommended}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource SupportedBrush}"
                                                                                   VerticalAlignment="Center" Margin="0,0,10,0" Visibility="{Binding Recommended, Converter={StaticResource BoolToVis}}"/>
                                                                        <TextBlock Text="{l:Tr postinstall.downloads}" FontSize="11" Foreground="{StaticResource UnknownBrush}"
                                                                                   VerticalAlignment="Center" Visibility="{Binding Downloads, Converter={StaticResource BoolToVis}}"/>
                                                                    </WrapPanel>
                                                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                                    <TextBlock Text="{Binding Unavailable}" Foreground="{StaticResource WarningBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                                                               Visibility="{Binding IsAvailable, Converter={StaticResource InverseBoolToVis}}"/>
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ TROUBLESHOOTING ============ -->
            <TabItem Style="{StaticResource NavTab}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE90F;" Style="{StaticResource NavIcon}"/>
                        <TextBlock Text="{l:Tr nav.trouble}" Style="{StaticResource NavLabel}"/>
                    </StackPanel>
                </TabItem.Header>
                <DockPanel Margin="28,24,0,0" DataContext="{Binding Troubleshooting}">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,28,10">
                        <TextBlock Text="{l:Tr trouble.title}" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="{l:Tr trouble.subtitle}" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,12" TextWrapping="Wrap"/>
                        <Grid>
                            <TextBox x:Name="TroubleSearch" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                                     AutomationProperties.Name="{l:Tr trouble.search}"/>
                            <TextBlock Text="{l:Tr trouble.search}" Foreground="{StaticResource UnknownBrush}" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TroubleSearch}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding Stages}" SelectedItem="{Binding SelectedStage}" Margin="0,10,0,0"/>
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                            <CheckBox IsChecked="{Binding OnlyRelevant}" Content="{l:Tr trouble.only_relevant}"/>
                        </DockPanel>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,28,24">
                        <StackPanel>
                            <TextBlock Text="{l:Tr trouble.none}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"
                                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,8">
                                            <StackPanel>
                                                <ToggleButton Style="{StaticResource RowToggle}" IsChecked="{Binding IsExpanded}" AutomationProperties.Name="{Binding Title}">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding StageLabel}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                        <TextBlock DockPanel.Dock="Right" Text="{l:Tr trouble.relevant}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"
                                                                   VerticalAlignment="Center" Margin="12,0,0,0" Visibility="{Binding Relevant, Converter={StaticResource BoolToVis}}"/>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    </DockPanel>
                                                </ToggleButton>
                                                <StackPanel Margin="46,0,18,16" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel Visibility="{Binding HasCause, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{l:Tr trouble.cause}" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/>
                                                        <TextBlock Text="{Binding Cause}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{l:Tr trouble.fix}" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/>
                                                    <TextBlock Text="{Binding Fix}" TextWrapping="Wrap" LineHeight="20"/>
                                                    <StackPanel Margin="0,10,0,0" Visibility="{Binding HasCommands, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{l:Tr trouble.commands}" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                                        <Border Background="{StaticResource BgBrush}" CornerRadius="6" Padding="12,8">
                                                            <DockPanel>
                                                                <Button DockPanel.Dock="Right" Style="{StaticResource CardButton}" Content="{l:Tr trouble.copy}"
                                                                        VerticalAlignment="Top" Click="OnCopyCommands"/>
                                                                <TextBox Text="{Binding CommandsText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                                                                         FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap"/>
                                                            </DockPanel>
                                                        </Border>
                                                    </StackPanel>
                                                    <ItemsControl ItemsSource="{Binding Fixes}" Margin="0,12,0,0">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Style="{StaticResource PrimaryButton}" Content="{Binding Label}" Margin="0,0,8,8" Click="OnTroubleFix"
                                                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        IsEnabled="{Binding DataContext.PostInstall.IsIdle, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <WrapPanel>
                                                        <Button Style="{StaticResource CardButton}" Padding="12,6" Content="{l:Tr trouble.guide}" Click="OnOpenUrl" Tag="{Binding Url}" Margin="0,0,12,0"/>
                                                        <TextBlock Text="{Binding Message}" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- ============ CHECKS ============ -->
            <TabItem Style="{StaticResource NavTab}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9D9;" Style="{StaticResource NavIcon}"/>
                        <TextBlock Text="{l:Tr nav.checks}" Style="{StaticResource NavLabel}"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24">
                    <StackPanel>
                        <TextBlock Text="{l:Tr checks.title}" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="{l:Tr checks.subtitle}" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,18"/>
                        <TextBlock Text="{l:Tr checks.none}" Foreground="{StaticResource MutedBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Findings.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Findings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardBrush}" CornerRadius="8" Margin="0,0,0,10"
                                            BorderBrush="{Binding Severity, Converter={StaticResource SeverityBrush}}" BorderThickness="3,0,0,0">
                                        <StackPanel Margin="16,12">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Severity, Converter={StaticResource SeverityLabel}}" FontSize="11" FontWeight="Bold"
                                                           Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding Area, Converter={StaticResource LocKey}, ConverterParameter=category.}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,2"/>
                                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ DEVICES ============ -->
            <TabItem Style="{StaticResource NavTab}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE772;" Style="{StaticResource NavIcon}"/>
                        <TextBlock Text="{l:Tr nav.devices}" Style="{StaticResource NavLabel}"/>
                    </StackPanel>
                </TabItem.Header>
                <DockPanel Margin="28,24">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="{l:Tr devices.title}" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="{l:Tr devices.subtitle}" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,12"/>
                        <TextBox Text="{Binding DeviceFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:Tr devices.filter}"/>
                        <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding Categories}" Margin="0,10,0,0"
                                 SelectedItem="{Binding SelectedCategoryChip}"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding DevicesView}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{l:Tr col.category}" Binding="{Binding Category, Converter={StaticResource LocKey}, ConverterParameter=category.}" Width="110"/>
                            <DataGridTextColumn Header="{l:Tr col.name}" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn Header="{l:Tr col.class}" Binding="{Binding Class}" Width="100"/>
                            <DataGridTextColumn Header="{l:Tr col.instance}" Binding="{Binding InstanceId}" Width="2*"/>
                            <DataGridTextColumn Header="{l:Tr col.pcipath}" Binding="{Binding PciPath}" Width="1.5*"/>
                            <DataGridTextColumn Header="{l:Tr col.acpipath}" Binding="{Binding AcpiPath}" Width="1.2*"/>
                            <DataGridTextColumn Header="{l:Tr col.driver}" Binding="{Binding Service}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============ ACPI ============ -->
            <TabItem Style="{StaticResource NavTab}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE943;" Style="{StaticResource NavIcon}"/>
                        <TextBlock Text="ACPI" Style="{StaticResource NavLabel}"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{l:Tr acpi.export}"
                                VerticalAlignment="Center" Click="OnExportAcpi" IsEnabled="{Binding HasReport}"/>
                        <StackPanel>
                            <TextBlock Text="ACPI" FontSize="24" FontWeight="SemiBold"/>
                            <TextBlock Text="{l:Tr acpi.subtitle}" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding AcpiDevices}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{l:Tr col.role}" Binding="{Binding Role, Converter={StaticResource LocKey}, ConverterParameter=acpi.role.}" Width="170"/>
                            <DataGridTextColumn Header="HID" Binding="{Binding HardwareId}" Width="110"/>
                            <DataGridTextColumn Header="{l:Tr col.path}" Binding="{Binding AcpiPath}" Width="*"/>
                            <DataGridTextColumn Header="{l:Tr col.name}" Binding="{Binding Name}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DataGrid Grid.Row="1" Grid.Column="2" ItemsSource="{Binding AcpiTables}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{l:Tr col.table}" Binding="{Binding Signature}" Width="70"/>
                            <DataGridTextColumn Header="OEM Table ID" Binding="{Binding OemTableId}" Width="*"/>
                            <DataGridTextColumn Header="{l:Tr col.bytes}" Binding="{Binding Length}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Width="220" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,18">
            <StackPanel Margin="22,0">
                <TextBlock Text="{l:Tr lang.label}" Style="{StaticResource SectionTitle}"/>
                <ListBox x:Name="LanguageList" Style="{StaticResource ChipList}" SelectionChanged="OnLanguageChanged"
                         AutomationProperties.Name="{l:Tr lang.label}"/>
                <TextBlock Text="{l:Tr app.footer}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Status bar -->
        <Border Grid.Row="1" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,6">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Right" Width="140" Height="4" IsIndeterminate="True" VerticalAlignment="Center"
                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
